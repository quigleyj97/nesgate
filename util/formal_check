#!/bin/bash

# Run SymbiYosys proofs against entities in the build library. For each
# <entity>:<sby file> pair, GHDL synthesizes the entity to a Verilog netlist at
# formal/<entity>.v (SymbiYosys can't read VHDL with the open source
# toolchain), then SymbiYosys runs every task in the .sby file. Results go in
# formal/<sby name>_<task>/.
#
# GHDL elaborates generics away, so a generic entity can list variants after
# the .sby file, each a comma-separated list of <generic>=<value>:
#
#   clock_divider:<sby file>:divide_by=2:divide_by=7
#
# Each variant is synthesized to its own netlist instead, named after the
# entity and the variant with every ',' and '=' turned into '_' (here
# formal/clock_divider_divide_by_2.v and formal/clock_divider_divide_by_7.v),
# and the .sby file reads each one in its own task.
#
# A proof that wires several entities together in its harness lists them all,
# joined by '+', and each one is synthesized to its own netlist:
#
#   predecode_register+decoder_rom:<sby file>
#
# Variants only apply to a proof of a single entity.
#
# Runs from the build directory, so .sby [files] paths are relative to it,
# like each core's `analyze` (e.g. ../cores/...). Every core must have been
# imported into the build library first.
#
# Every entity is synthesized first, one at a time, since GHDL shares the build
# library. Then every task of every .sby file runs as its own SymbiYosys job,
# FORMAL_JOBS at a time (by default, one per CPU), in the order the proofs are
# listed, so list the slowest first. Each task's log goes to
# formal/<sby name>_<task>/logfile.txt, and a failed task's log is printed.
#
# Usage: formal_check <build dir> <entity>[+<entity>...]:<sby file>[:<variant>...]...

set -x

BUILD_DIR=$1
shift

failed=()
JOBS=${FORMAL_JOBS:-$(getconf _NPROCESSORS_ONLN)}

# SymbiYosys writes a JUnit report for every task, but never runs if the entity
# doesn't synthesize. Write one in the same shape so util/merge_formal_results
# reports the failure too.
write_synth_failure() {
    local name=$1 entity=$2
    mkdir -p "formal/${name}_synth"
    cat > "formal/${name}_synth/${name}_synth.xml" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<testsuites>
<testsuite package="$name" name="synth" tests="1" errors="1" failures="0" skipped="0" time="0">
<testcase classname="synth" name="synthesize $entity" time="0">
<error type="ERROR" message="GHDL failed to synthesize $entity"/>
</testcase>
</testsuite>
</testsuites>
EOF
}

pushd "$BUILD_DIR" > /dev/null
mkdir -p formal
# One line per SymbiYosys task to run: <sby file> <name> <task>
job_list=$(mktemp)
failed_tasks=$(mktemp)
trap 'rm -f "$job_list" "$failed_tasks"' EXIT
# Synthesize <entity> with the given generics to <netlist>
synthesize() {
    local entity=$1 netlist=$2 generics=$3
    eval "$GHDL --synth --out=verilog $generics $entity" > "$netlist"
}

for proof in "$@"; do
    IFS=: read -r entity sby_file variant_list <<< "$proof"
    variants=()
    if [ -n "$variant_list" ]; then
        IFS=: read -ra variants <<< "$variant_list"
    fi
    name=$(basename "$sby_file" .sby)

    IFS=+ read -ra entities <<< "$entity"

    synthesized=true
    if [ ${#entities[@]} -gt 1 ]; then
        for part in "${entities[@]}"; do
            if ! eval "$GHDL -m -b $part" || ! synthesize "$part" "formal/$part.v" ""; then
                synthesized=false
                failed_entity=$part
                break
            fi
        done
    elif ! eval "$GHDL -m -b $entity"; then
        synthesized=false
        failed_entity=$entity
    elif [ ${#variants[@]} -eq 0 ]; then
        if ! synthesize "$entity" "formal/$entity.v" ""; then
            synthesized=false
            failed_entity=$entity
        fi
    else
        for variant in "${variants[@]}"; do
            generics=""
            for generic in ${variant//,/ }; do
                generics+=" -g$generic"
            done
            if ! synthesize "$entity" "formal/${entity}_${variant//[,=]/_}.v" "$generics"; then
                synthesized=false
                failed_entity="$entity ($variant)"
                break
            fi
        done
    fi
    if ! $synthesized; then
        failed+=("$sby_file (synthesizing $failed_entity)")
        write_synth_failure "$name" "$failed_entity"
        continue
    fi
    tasks=$(sby --dumptasks "$sby_file")
    if [ -z "$tasks" ]; then
        failed+=("$sby_file (no tasks)")
        continue
    fi
    for task in $tasks; do
        echo "$sby_file $name $task" >> "$job_list"
    done
done

# Run one SymbiYosys task, and record it if it fails
run_task() {
    local sby_file=$1 name=$2 task=$3
    local start=$(date +%s)
    if sby -f --prefix "formal/$name" "$sby_file" "$task" > /dev/null 2>&1; then
        echo "PASS ${name}_$task ($(( $(date +%s) - start ))s)"
    else
        echo "FAIL ${name}_$task ($(( $(date +%s) - start ))s)"
        tail -n 40 "formal/${name}_$task/logfile.txt" 2>/dev/null
        echo "$sby_file ($task)" >> "$FAILED_TASKS"
    fi
}
export -f run_task
export FAILED_TASKS=$failed_tasks

set +x
echo "Running $(wc -l < "$job_list" | tr -d ' ') tasks, $JOBS at a time"
xargs -P "$JOBS" -n 3 bash -c 'run_task "$@"' _ < "$job_list"
set -x
while read -r line; do
    failed+=("$line")
done < "$failed_tasks"
popd > /dev/null

if [ ${#failed[@]} -ne 0 ]; then
    set +x
    echo "formal_check failed for:" >&2
    printf '  %s\n' "${failed[@]}" >&2
    exit 1
fi
