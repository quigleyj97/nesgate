#!/bin/bash

set -x
set -e

rm -rf build
mkdir -p build

BASE_DIR=`realpath .`
BUILD_DIR=$BASE_DIR/build

CONTAINER_RUNNER=docker
TRELLIS_CONTAINER_NAME=hdlc/prjtrellis
TRELLIS_NEXTPNR_CONTAINER_NAME=hdlc/nextpnr:ecp5
GHDL_YOSYS_CONTAINER_NAME=hdlc/ghdl:yosys
# The hdlc images are amd64-only; this lets them run under emulation on arm64
CONTAINER_ARGS="--rm --platform linux/amd64 -v $BASE_DIR:/src -w /src/build"

# Use a natively installed tool (e.g. from OSS CAD Suite) if one is on the
# PATH, otherwise fall back to running it in a container.
# Usage: find_tool <binary> <container image>
find_tool() {
    if command -v "$1" > /dev/null; then
        echo "$1"
    else
        echo "$CONTAINER_RUNNER run $CONTAINER_ARGS $2 $1"
    fi
}

export GHDL=$(find_tool ghdl $GHDL_YOSYS_CONTAINER_NAME)
YOSYS=$(find_tool yosys $GHDL_YOSYS_CONTAINER_NAME)
NEXTPNR=$(find_tool nextpnr-ecp5 $TRELLIS_NEXTPNR_CONTAINER_NAME)
ECPPACK=$(find_tool ecppack $TRELLIS_CONTAINER_NAME)

# Lint the Python testbenches and tooling first, since it's fast. Needs the
# dev packages (`pipenv install --dev`).
ruff check .

start_analysis=$(date +%s)

CORES=()
for core in cores/*; do
    # Skip the index.md file as that's not actually a core
    if [ -d $core ]; then
        CORES+=($core)
    fi
done

# Import every core first, since cores can depend on one another (e.g. blinky
# uses clock_divider)
for core in "${CORES[@]}"; do
    pushd $core
    ./analyze $BUILD_DIR
    popd
done

for core in "${CORES[@]}"; do
    pushd $core
    ./test $BASE_DIR
    popd
done

end_analysis=$(date +%s)

python -m util.merge_test_results $start_analysis $end_analysis ./build/**/results.xml

# Type-check the testbenches, as Pylance does. This has to come after the tests,
# which write the DUT type stubs in typings/.
pyright

# Analyze and synthesize every entity on its own, including ones the toplevel
# doesn't use yet. Check every core before failing, so all problems are listed.
failed_cores=()
for core in "${CORES[@]}"; do
    if ! $core/check $BUILD_DIR; then
        failed_cores+=($core)
    fi
done
if [ ${#failed_cores[@]} -ne 0 ]; then
    echo "Entity checks failed in: ${failed_cores[*]}" >&2
    exit 1
fi

# TODO: Move this into a separate, target-specific script
IDCODE=0x41113043

# Analyze toplevel
pushd $BUILD_DIR
    eval "$GHDL -i ../targets/ulx3s_85k.vhdl"
    # Bind only (-b), without linking a simulation executable. Several cores
    # have a core.vhdl, and with GHDL's LLVM/GCC backends they all compile to
    # the same core.o, so linking would pick up the wrong one. Synthesis only
    # needs the analyzed library.
    eval "$GHDL -m -b toplevel"

    # Synthesize. GHDL emits a Verilog netlist for yosys to read, rather than
    # going through the ghdl-yosys-plugin, which has crashed on this design
    # (ASSERTION_ERROR in netlists.adb) in some OSS CAD Suite builds.
    eval "$GHDL --synth --out=verilog toplevel" > ./toplevel.v

    # The ECP5 fabric has no internal tri-state buffers, so the CPU's shared
    # 'Z'-driven buses only synthesize once the design is flattened and
    # `tribuf -logic` turns them into muxes. Without that, yosys just warns
    # about "multiple conflicting drivers" and produces a broken netlist, so
    # make that warning an error.
    eval "$YOSYS -e 'conflicting drivers' -p 'read_verilog ./toplevel.v; hierarchy -top toplevel; proc; flatten; tribuf -logic; debug synth_ecp5 -top toplevel -json ./toplevel.ulx3s.json'"
    eval "$NEXTPNR --json ./toplevel.ulx3s.json --textcfg ./toplevel.ulx3s.config --lpf ../targets/ulx3s.lpf --85k --package CABGA381"
    eval "$ECPPACK ./toplevel.ulx3s.config ./toplevel.ulx3s.bit --idcode $IDCODE"
popd
