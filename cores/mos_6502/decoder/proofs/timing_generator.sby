[tasks]
prove
cover

[options]
prove: mode prove
cover: mode cover
cover: depth 60

[engines]
prove: abc pdr
cover: smtbmc z3

[script]
read_verilog timing_generator.v
read_verilog -formal -sv two_phase_clock.sv
read_verilog -formal -sv timing_generator_formal.sv
prep -top timing_generator_formal
check -assert

[files]
formal/timing_generator.v
../cores/mos_6502/decoder/proofs/two_phase_clock.sv
../cores/mos_6502/decoder/proofs/timing_generator_formal.sv
