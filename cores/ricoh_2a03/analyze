#!/bin/bash

set -x
set -e

# The 2A03 is built from the 6502 core, so import that first
"$(dirname "$0")/../mos_6502/analyze" $1

FILES="../cores/ricoh_2a03/apu/apu_counter.vhdl \
    ../cores/ricoh_2a03/apu/aclk_generator.vhdl \
    ../cores/ricoh_2a03/apu/frame_counter.vhdl \
    ../cores/ricoh_2a03/apu/length_decoder.vhdl \
    ../cores/ricoh_2a03/apu/length_counter.vhdl \
    ../cores/ricoh_2a03/apu/envelope_unit.vhdl \
    ../cores/ricoh_2a03/apu/square_channel.vhdl \
    ../cores/ricoh_2a03/apu/triangle_channel.vhdl \
    ../cores/ricoh_2a03/ricoh_2a03.vhdl"

pushd $1
eval "$GHDL -i $FILES"
popd
