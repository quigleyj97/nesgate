#!/bin/bash

# Formally verify this core's entities. Run by `formal` after every core has
# been imported. $1 is the build directory.

set -e

# <entity>:<sby file>, with the .sby path relative to the build directory
PROOFS=(
    phased_clock_generator:../cores/phased_clock_generator/proofs/phased_clock_generator.sby
)

"$(dirname "$0")/../../util/formal_check" "$1" "${PROOFS[@]}"
