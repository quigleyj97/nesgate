[tasks]
prove
cover

[options]
prove: mode prove
cover: mode cover
cover: depth 10
multiclock on

[engines]
prove: abc pdr
cover: smtbmc z3

[script]
read_verilog phased_clock_generator.v
read_verilog -formal -sv phased_clock_generator_formal.sv
prep -top phased_clock_generator_formal
check -assert

[files]
formal/phased_clock_generator.v
../cores/phased_clock_generator/proofs/phased_clock_generator_formal.sv
