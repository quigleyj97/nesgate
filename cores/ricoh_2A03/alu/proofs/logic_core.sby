[tasks]
prove
cover

[options]
prove: mode prove
cover: mode cover
cover: depth 12
multiclock on

[engines]
prove: abc pdr
cover: smtbmc z3

[script]
read_verilog logic_core.v
read_verilog -formal -sv logic_core_formal.sv
prep -top logic_core_formal
flatten
tribuf -merge
techmap -map precharge_tribuf.v
check -assert

[files]
formal/logic_core.v
../cores/ricoh_2A03/alu/proofs/logic_core_formal.sv
../techmaps/precharge_tribuf.v
