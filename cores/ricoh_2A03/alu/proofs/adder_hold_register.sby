[tasks]
prove
cover

[options]
prove: mode prove
cover: mode cover
cover: depth 6
multiclock on

[engines]
prove: abc pdr
cover: smtbmc z3

[script]
read_verilog adder_hold_register.v
read_verilog -formal -sv adder_hold_register_formal.sv
prep -top adder_hold_register_formal
flatten
tribuf -merge
techmap -map precharge_tribuf.v
check -assert

