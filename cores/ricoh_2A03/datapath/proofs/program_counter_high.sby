[tasks]
prove
cover

[options]
prove: mode prove
cover: mode cover
cover: depth 12
multiclock on

[engines]
prove: abc pdr
cover: smtbmc z3

[script]
read_verilog program_counter_high.v
read_verilog -formal -sv program_counter_high_formal.sv
prep -top program_counter_high_formal
flatten
tribuf -merge
techmap -map precharge_tribuf.v
check -assert

[files]
formal/program_counter_high.v
../cores/ricoh_2A03/datapath/proofs/program_counter_high_formal.sv
../techmaps/precharge_tribuf.v
